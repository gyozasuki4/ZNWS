{
  "openapi": "3.1.0",
  "info": {
    "title": "ZASNet Model Imagery API",
    "version": "1.0.0",
    "description": "Read-only model catalogs, frame metadata, and transparent Web Mercator viewport overlays."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/models": { "get": { "operationId": "listModels", "responses": { "200": { "description": "Available models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } } } } } },
    "/v1/models/{model}/runs": { "get": { "operationId": "listModelRuns", "parameters": [{ "$ref": "#/components/parameters/Model" }], "responses": { "200": { "description": "Available initialization runs" } } } },
    "/v1/models/{model}/{run}/products": { "get": { "operationId": "listModelProducts", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }], "responses": { "200": { "description": "Products available in the run" } } } },
    "/v1/models/{model}/{run}/{product}/frames": { "get": { "operationId": "listModelFrames", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }, { "$ref": "#/components/parameters/Product" }], "responses": { "200": { "description": "Forecast frames", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FrameList" } } } } } } },
    "/v1/models/{model}/{run}/{product}/{forecastHour}/overlay.png": { "get": { "operationId": "getModelOverlay", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }, { "$ref": "#/components/parameters/Product" }, { "name": "forecastHour", "in": "path", "required": true, "schema": { "type": "number", "minimum": 0 } }, { "name": "bbox", "in": "query", "required": true, "description": "WGS84 west,south,east,north bounds.", "schema": { "type": "string" } }, { "name": "width", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 64, "maximum": 4096 } }], "responses": { "200": { "description": "Transparent PNG whose pixels are aligned to EPSG:3857", "headers": { "ETag": { "schema": { "type": "string" } }, "Last-Modified": { "schema": { "type": "string" } }, "Cache-Control": { "schema": { "type": "string" } } }, "content": { "image/png": { "schema": { "type": "string", "contentEncoding": "binary" } } } } } } },
    "/v1/models/{model}/{run}/{product}/{forecastHour}/grid/conus.bin": { "get": { "operationId": "getConusModelGrid", "description": "Compressed 4096-pixel-wide full-CONUS numerical grid for supported HRRR products, including MSLP pressure.", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }, { "$ref": "#/components/parameters/Product" }, { "name": "forecastHour", "in": "path", "required": true, "schema": { "type": "number", "minimum": 0 } }], "responses": { "200": { "$ref": "#/components/responses/NumericalGrid" } } } },
    "/v1/models/{model}/{run}/{product}/{forecastHour}/grid/domain.bin": { "get": { "operationId": "getZnwsWrfModelGrid", "description": "ZNWS-WRF numerical grid for the run's MESO domain.", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }, { "$ref": "#/components/parameters/Product" }, { "name": "forecastHour", "in": "path", "required": true, "schema": { "type": "number", "minimum": 0 } }], "responses": { "200": { "$ref": "#/components/responses/NumericalGrid" } } } },
    "/v1/models/{model}/{run}/{product}/{forecastHour}/grid/{domain}.bin": { "get": { "operationId": "getHafsModelGrid", "description": "HAFS-A/B numerical grid for the high-resolution storm domain or larger parent domain.", "parameters": [{ "$ref": "#/components/parameters/Model" }, { "$ref": "#/components/parameters/Run" }, { "$ref": "#/components/parameters/Product" }, { "name": "forecastHour", "in": "path", "required": true, "schema": { "type": "number", "minimum": 0 } }, { "name": "domain", "in": "path", "required": true, "schema": { "type": "string", "enum": ["storm", "parent"] } }, { "name": "component", "in": "query", "required": false, "description": "For refcmslp, request refc or pressure.", "schema": { "type": "string", "enum": ["refc", "pressure"] } }], "responses": { "200": { "$ref": "#/components/responses/NumericalGrid" } } } }
  },
  "components": {
    "parameters": {
      "Model": { "name": "model", "in": "path", "required": true, "schema": { "type": "string", "enum": ["hrrr", "gfs", "znws-wrf-meso1", "znws-wrf-meso2", "znws-wrf-meso3", "hafs-a", "hafs-b"] } },
      "Run": { "name": "run", "in": "path", "required": true, "schema": { "type": "string" } },
      "Product": { "name": "product", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": { "NumericalGrid": { "description": "ZASGRID v1 envelope containing deflate-compressed little-endian UInt16 samples", "headers": { "ETag": { "schema": { "type": "string" } }, "Last-Modified": { "schema": { "type": "string" } }, "Cache-Control": { "schema": { "type": "string" } }, "X-Schema-Version": { "schema": { "const": "1.0.0" } } }, "content": { "application/vnd.zasnet.model-grid": { "schema": { "type": "string", "contentEncoding": "binary" } } } } },
    "schemas": {
      "ModelList": { "type": "object", "required": ["schemaVersion", "models"], "properties": { "schemaVersion": { "const": "1.0.0" }, "models": { "type": "array", "items": { "type": "object", "required": ["id", "displayName", "runsUrl"] } } } },
      "Product": { "type": "object", "required": ["id", "displayName", "palette", "coverageBounds", "sourceProjection", "outputProjection", "forecastHours", "overlayTemplate"], "properties": { "id": { "type": "string" }, "displayName": { "type": "string" }, "unit": { "type": ["string", "null"] }, "palette": { "type": "array" }, "displayRange": { "type": ["object", "null"] }, "coverageBounds": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }, "sourceProjection": { "type": "string" }, "outputProjection": { "const": "EPSG:3857" }, "forecastHours": { "type": "array", "items": { "type": "number" } }, "overlayTemplate": { "type": "string" } } },
      "FrameList": { "type": "object", "required": ["schemaVersion", "model", "run", "product", "frames"], "properties": { "schemaVersion": { "const": "1.0.0" }, "model": { "type": "string" }, "product": { "$ref": "#/components/schemas/Product" }, "frames": { "type": "array", "items": { "type": "object", "required": ["forecastHour", "validTime", "overlayUrl"], "properties": { "forecastHour": { "type": "number" }, "validTime": { "type": "string", "format": "date-time" }, "overlayUrl": { "type": "string" } } } } } }
    }
  }
}
